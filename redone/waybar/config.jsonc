{
    "position": "top",
    "margin-top": 15,
    "modules-left": [
        "clock",
        "user",
        "hyprland/workspaces"
    ],
    "modules-center": [
        //"network#speed",
        "cpu",
        "disk",
        "temperature",
        "memory"
    ],
    "modules-right": [
        "cava",
        //"bluetooth",
        //"network#wifi",
        //"network#ethernet",
        //"battery",
        "custom/notification"
    ],
    "user": {
        "format": " {user} (up {work_d} days, {work_H} H, {work_M} M and {work_S} S ↑)",
        "interval": 1,
        "height": 30,
        "width": 30,
        "icon": true
    },
    "network#wifi": {
        "interface": "wlan0",
        "format-wifi": " WiFi {signalStrength}% ⬇ {bandwidthDown} ⬆ {bandwidthUp}",
        "format-disconnected": "no WiFi connection",
        "interval": 1
    },
    "network#ethernet": {
        "interface": "enp7s0f1",
        "format-ethernet": " ETH  ",
        "format-disconnected": "no Ethernet connection",
        "interval": 1
    },
    "network#speed": {
        "interface": "enp7s0f1",
        "format-wifi": "⬇ {bandwidthDown} ⬆ {bandwidthUp}",
        "interval": 1
    },
    "bluetooth": {
        "format": " {status}",
        "format-connected": " {device_alias}",
        "format-connected-battery": " {device_alias} {device_battery_percentage}%",
        // "format-device-preference": [ "device1", "device2" ], // preference list deciding the displayed device
        "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%"
    },
    "cava": {
        //"cava_config": "$XDG_CONFIG_HOME/cava/cava",
        "framerate": 30,
        "autosens": 1,
        "sensitivity": 2,
        "bars": 14,
        "lower_cutoff_freq": 50,
        "higher_cutoff_freq": 10000,
        "hide_on_silence": false,
        // "format_silent": "quiet",
        "method": "pulse",
        "source": "auto",
        "stereo": true,
        "reverse": false,
        "bar_delimiter": 0,
        "monstercat": false,
        "waves": false,
        "noise_reduction": 0.77,
        "input_delay": 0,
        "format-icons": [
            "▁",
            "▂",
            "▃",
            "▄",
            "▅",
            "▆",
            "▇",
            "█"
        ],
        "actions": {
            "on-click-right": "mode"
        }
    },
    "disk": {
        "interval": 30,
        "format": "{specific_used:0.2f} GiB /{specific_total:0.2f} GiB",
        "tooltip-format":"left: {free}/{total}",
        "unit": "GB"
        // 0.25 GB out of 2000.00 GB available. Alternatively 241.3MiB out of 1.9TiB available.
    },
    "memory": {
        "interval": 1,
        "format": "{used:0.1f}G/{total:0.1f}G "
    },
    "clock": {
        "interval": 1,
        "tooltip": true,
        "format": "{:%H:%M:%S} ",
        "tooltip-format": "{:%Y-%m-%d}"
    },
    "hyprland/workspaces": {
        "format": "{name}"
    },
    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-bluetooth": "{volume}% {icon}",
        "format-muted": "",
        "format-icons": {
            "alsa_output.pci-0000_00_1f.3.analog-stereo": "",
            "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": " ",
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "phone-muted": "",
            "portable": "",
            "car": "",
            "default": [
                "",
                ""
            ]
        },
        "scroll-step": 1,
        "on-click": "pavucontrol",
        "ignored-sinks": [
            "Easy Effects Sink"
        ]
    },
    "cpu": {
        "interval": 10,
        "format": "{}% ",
        "max-length": 10
    },
    "temperature": {
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        "format-critical": "{temperatureC}°C ",
        "format": "{temperatureC}°C "
    },
    "battery": {
        "bat": "BAT1",
        "interval": 60,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ],
        "max-length": 25
    },
    "custom/notification": {
        "tooltip": true,
        "format": "<span size='16pt'>{icon}</span>",
        "format-icons": {
            "notification": "󱅫",
            "none": "󰂜",
            "dnd-notification": "󰂠",
            "dnd-none": "󰪓",
            "inhibited-notification": "󰂛",
            "inhibited-none": "󰪑",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰪑"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    }
}